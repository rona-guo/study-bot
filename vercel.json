{
  "version": 2,
  "builds": [
    {
      "src": "server/api/**/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "client/dist/**",
      "use": "static"
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "server/api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "client/dist/$1"
    }
  ]
}
